# 用户隐私 / 本地配置 —— 永不入库
.env
.env.bak*
.venv/
sessions/
onboarding/data/
# daemon 专属 CDP Edge profile（登录态/缓存）—— 运行时二进制·永不入库
# （sessions/ 已整体忽略·此行显式留痕：浏览器的手新增的专属 profile）
sessions/edge_cdp_profile/

# 相遇产生的用户身份（开源仓库只带空模板，不带某个用户填充后的内容）
soul/IDENTITY.json
soul/onboarding.json
# 用户画像 —— 每个用户的私人内容·首次相遇由 _ensure_data 自动重建空模板·不入库
soul/OWNER-NOTEBOOK.md
soul/SHE-STATE.md
# 实例宪法 —— 实例私有·从使用中沉淀(通用三条在 product_constitution.py·内核共享)·不入库
soul/CONSTITUTION.md

# data/ 运行时数据：只保留机制(cognition) + 占位，私人数据全部忽略
# 手册蒸馏草稿只活在本机 · 不入库
data/playbooks/_drafts/
data/*
!data/.gitkeep
!data/cognition
data/cognition/_archive/

# 本机/社区叠层（升级不碰；data/* 已挡住 data/mods）
agent_tools_user/*.py
api_routes_user/*.py

# 自带应用「内容制作」随仓库出厂（用户开箱即用·对齐后续应用/工作流的参考样板）。
# git 坑: 父目录被 data/* 忽略时·子文件的 ! 白名单必须逐级放行父目录才生效。
!data/workshop
data/workshop/*
!data/workshop/apps
data/workshop/apps/*
!data/workshop/apps/app-46efb986.json

# Daemonkey.exe 故意【不】忽略——它进仓库让用户 clone 即开箱即用。
# 由 tools/build-boot-exe.ps1 编薄壳（csc · DaemonkeyBoot.cs）。禁止用旧 build-exe.ps1 打肉版。

# 桌宠运行时文件（pet 自己生成 · 私人状态/位置 · 不入库）
desktop_pet/state.txt
desktop_pet/activity.txt
desktop_pet/activity.jsonl
desktop_pet/position.txt
desktop_pet/inbox.txt

# Python / 运行时垃圾
__pycache__/
*.pyc
*.log
*.err
.pytest_cache/
.ruff_cache/

# Office 临时锁文件（打开 docx 自动生成 · 永不入库）
~$*
# 构建产物 (Mac/Windows 包·release 附件分发·不进 git)
/dist/
/*.dmg
/Daemonkey.app/

desktop_pet/confirm.txt

desktop_pet/bubble.txt
